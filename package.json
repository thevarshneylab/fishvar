{
  "name": "fishvar",
  "version": "0.1.0",
  "description": "Map a human ClinVar missense variant onto its orthologous zebrafish codon and design Umax base-editing guides for it.",
  "keywords": [
    "zebrafish",
    "base editing",
    "clinvar",
    "crispr",
    "sgrna",
    "orthologue",
    "variant",
    "danio rerio"
  ],
  "license": "MIT",
  "bin": {
    "fishvar": "bin/fishvar.js"
  },
  "main": "lib/pipeline.js",
  "scripts": {
    "fixtures": "node test/build-fixtures.js",
    "bundle": "node tools/bundle.js",
    "test": "node test/build-fixtures.js && node test/run.js && node tools/bundle.js --check && node test/bundle.js && node test/dom.js",
    "coverage": "node tools/coverage.js",
    "serve": "node test/serve.js",
    "demo": "node bin/fishvar.js TESTA:p.Arg100His --cache-dir ./fixtures --cache-only --top 3"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "files": [
    "bin",
    "lib",
    "vendor",
    "docs",
    "README.md"
  ]
}
